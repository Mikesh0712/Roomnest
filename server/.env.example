PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/roomnest
JWT_SECRET=your_generated_random_64_byte_hex_string
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,https://your-roomnest-app.vercel.app

CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

GOOGLE_MAPS_KEY=your_google_maps_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

